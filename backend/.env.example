# FieldOps AI backend environment configuration.
# Copy this file to `.env` and fill in the values for your local setup.
# Never commit real credentials.

# Application
APP_NAME=FieldOps AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=1048576

# Database (must use the asyncpg driver)
DATABASE_URL=postgresql+asyncpg://fieldops:fieldops@localhost:5432/fieldops
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5
DB_ECHO=false
DB_REQUIRE_TLS=true

# Optional isolated database for integration tests. When unset, the test suite
# creates and drops temporary databases on the configured PostgreSQL server.
# TEST_DATABASE_URL=postgresql+asyncpg://fieldops:fieldops@localhost:5432/fieldops_test

# Redis (used by later phases; the API does not require it to start)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# Authentication bootstrap rate limiting
AUTH_BOOTSTRAP_RATE_LIMIT_PER_IP=30
AUTH_BOOTSTRAP_RATE_LIMIT_PER_SUBJECT=10
AUTH_BOOTSTRAP_RATE_LIMIT_WINDOW_SECONDS=60

# Celery (background processing is not enabled in Phase 1)
CELERY_TASK_ALWAYS_EAGER=false

# AI provider configuration (used by later phases)
GOOGLE_API_KEY=
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=mistralai/mistral-large-2512
